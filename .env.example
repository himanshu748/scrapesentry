APP_ENV=demo
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3100

# Continuous monitoring is opt-in to prevent accidental paid collector runs
MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=60
MUTATION_RATE_LIMIT_PER_MINUTE=60

# Required for state-changing API calls in APP_ENV=production
# Configure the same server-only value on the API and Next.js dashboard services
OPERATOR_API_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.onrender.com

# Optional signed notifications for new incidents and verified recoveries
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Required only for APP_ENV=production
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_COLLECTOR_ID=c_msxcshnz2bwrroekf3
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_POLL_TIMEOUT_SECONDS=180

# Optional production audit mirror
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
